<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 控制台输出：简洁模式 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level %logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Spring / MyBatis / HikariCP 框架日志 → WARN -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.mybatis" level="WARN"/>
    <logger name="com.baomidou.mybatisplus" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.apache.catalina" level="WARN"/>
    <logger name="org.eclipse.paho" level="INFO"/>

    <!-- 静默处理：心跳、遥测接收日志 → WARN（仅异常时输出） -->
    <logger name="com.experiment.smartlightingexp.task.HeartbeatMonitorTask" level="WARN"/>

    <!-- 业务日志 → INFO -->
    <logger name="com.experiment.smartlightingexp" level="INFO"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
